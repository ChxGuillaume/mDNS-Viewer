{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "smb://*"
        },
        {
          "url": "afp://*"
        },
        {
          "url": "nfs://*"
        },
        {
          "url": "ftp://*"
        },
        {
          "url": "ssh://*"
        },
        {
          "url": "sftp://*"
        },
        {
          "url": "vnc://*"
        }
      ]
    }
  ]
}
